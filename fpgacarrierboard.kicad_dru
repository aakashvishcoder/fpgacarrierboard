(version 1)

(rule "U6 BGA escape"
  (condition "A.intersectsCourtyard('U6')")
  (constraint clearance (min 0.1mm))
  (constraint track_width (min 0.1mm) (opt 0.12mm))
  (constraint via_diameter (min 0.45mm) (opt 0.45mm))
  (constraint hole_size (min 0.2mm) (opt 0.2mm)))

(rule "Solid GND on regulators and BGA caps"
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('U1') || A.memberOfFootprint('U2') || A.memberOfFootprint('U3') || A.memberOfFootprint('U4') || A.memberOfFootprint('U5') || A.memberOfFootprint('C81') || A.memberOfFootprint('C83') || A.memberOfFootprint('C80') || A.memberOfFootprint('Y1'))")
  (constraint zone_connection solid))

(rule "Through-hole GND thermals"
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('J4') || A.memberOfFootprint('C22'))")
  (constraint min_resolved_spokes 1))
